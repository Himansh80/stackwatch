[Unit]
Description=StackWatch web frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/stackwatch/web
ExecStart=/usr/bin/python3 /opt/stackwatch/web/static_server.py --root /opt/stackwatch/web/public --api http://127.0.0.1:8080 --port 8090
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
